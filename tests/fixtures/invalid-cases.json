        "strikePercents": [
          137,
          127,
          125,
          101,
          100,
          70
        ]
      },
      "fill": [
        [
          "input-protection",
          "-1"
        ]
      ],
      "field": "protection",
      "label": "Protection",
      "message": "below 100%"
    },
    {
