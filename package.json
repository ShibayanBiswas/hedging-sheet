{
  "name": "hedging-sheet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "vercel-build": "tsx scripts/db-deploy-setup.ts && next build",
    "start": "next start --port 3005",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude \"tests/golden/**\" --exclude \"tests/api/**\"",
    "test:component": "vitest run tests/component",
    "test:api": "vitest run tests/api",
    "test:export": "vitest run tests/export",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:blank": "playwright test e2e/blank",
    "e2e:default": "playwright test e2e/default",
    "e2e:copy": "playwright test e2e/copy-rules.spec.ts e2e/capitalisation.spec.ts",
    "e2e:perf": "playwright test e2e/perf.spec.ts --project=chromium",
    "e2e:responsive": "playwright test e2e/responsive --project=chromium",
    "e2e:responsive:update": "playwright test e2e/responsive --project=chromium --grep \"visual baselines\" --update-snapshots",
    "e2e:server": "npx tsx scripts/e2e-server.ts",
    "fixtures:build": "npx tsx scripts/build-test-fixtures.ts && npx tsx scripts/build-regression-fixture.ts && npx tsx scripts/build-table-schema.ts",
    "lhci": "lhci autorun",
    "test:all": "npm run typecheck && npm run lint && npm run test:unit && npm run test:golden && npm run test:api && npm run verify:mapping && npm run verify:copy && npm run test:e2e",
    "report": "playwright show-report playwright-report",
    "build:samples": "npx tsx scripts/build-sample-inputs.ts",
    "verify:calculations": "npx tsx scripts/verify-calculations.ts",
    "verify:pricer": "npx tsx scripts/verify-pricer.ts",
    "verify:exports": "npx tsx scripts/verify-exports.ts",
    "verify:vol-upload": "npx tsx scripts/verify-vol-upload.ts",
    "verify:edge-cases": "npx tsx scripts/verify-edge-cases.ts",
    "verify:mongo": "npx tsx scripts/verify-mongo.ts",
    "verify": "npm run verify:calculations && npm run verify:pricer && npm run verify:exports && npm run verify:vol-upload && npm run verify:edge-cases",
    "seed:mongo": "npx tsx scripts/seed-mongo.ts",
    "db:audit": "tsx scripts/db-audit.ts",
    "db:cleanup": "tsx scripts/db-cleanup.ts",
    "db:apply-validators": "tsx scripts/db-apply-validators.ts",
    "db:ensure-indexes": "tsx scripts/db-ensure-indexes.ts",
    "cache:clear": "tsx scripts/clear-caches.ts",
    "bake:vol-surface": "npx tsx scripts/bake-vol-surface.ts",
    "e2e:local": "npx tsx scripts/e2e-local.ts",
    "test:golden": "vitest run tests/golden",
    "test:e2e": "playwright test --project=chromium",
    "test:visual": "playwright test e2e/visual --project=chromium",
    "test:visual:update": "playwright test e2e/visual --project=chromium --update-snapshots",
    "test:a11y": "playwright test e2e/a11y.spec.ts e2e/blank/b20-b22-mobile-themes-a11y.spec.ts --project=chromium --grep \"axe|a11y|B22\"",
    "test:prod": "playwright test --project=prod",
    "test:prod:responsive": "playwright test --project=prod-responsive",
    "verify:mapping": "tsx scripts/extract-mapping.ts",
    "verify:copy": "vitest run tests/copy tests/unit/copy-rules.test.ts tests/unit/title-case.test.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "fixtures:workbook": "tsx scripts/extract-workbook-values.ts",
    "test:visual:linux": "tsx scripts/visual-baselines.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "framer-motion": "12.43.0",
    "lucide-react": "0.539.0",
    "mongodb": "7.4.0",
    "next": "16.4.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "3.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-config-next": "16.4.2",
    "fast-check": "^3.23.2",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "msw": "^2.15.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "motion-dom": "12.43.0",
    "motion-utils": "12.39.0"
  }
}
