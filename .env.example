# Copy to .env.local and fill in values. Never commit real secrets.

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.lvoycia.mongodb.net/hedging_sheet?retryWrites=true&w=majority
MONGODB_DB=hedging_sheet
# Previews and development deployments use hedging_sheet_preview and hedging_sheet_development; tests use an in-memory database.

# Every save needs this key: the surface upload, the surface editor and the surface parameters. Generate a long random value.
DESK_WRITE_KEY=
# Optional: saves allowed per address per ten minutes, default 20.
# DESK_WRITE_LIMIT=20

# Alternative to MONGODB_URI:
# MONGODB_HOST=cluster0.lvoycia.mongodb.net
# MONGODB_USER=
# MONGODB_PASSWORD=
