{
  "ci": {
    "collect": {
      "startServerCommand": "npx tsx scripts/e2e-server.ts",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 240000,
      "url": ["http://localhost:3006/", "http://localhost:3006/pricer"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05, "aggregationMethod": "median" }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "test-results/lighthouse-mobile" }
  }
}
